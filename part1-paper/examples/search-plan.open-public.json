    "datacite": { "limit": 20, "ranking_policy": "latest-first" },
    "arxiv": { "limit": 20, "ranking_policy": "latest-first" },
    "core": { "limit": 20, "ranking_policy": "latest-first", "api_key_env_var": "CORE_API_KEY" },
    "openalex": { "limit": 20, "ranking_policy": "latest-first", "api_key_env_var": "OPENALEX_API_KEY" }
  },
  "output_requirements": ["candidate papers", "search log", "coverage notes", "latest literature first"]
