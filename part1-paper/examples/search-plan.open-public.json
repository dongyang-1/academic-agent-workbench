    "time_range": "2015-2026",
    "geography": null,
    "methods": ["policy evaluation", "difference-in-differences", "panel data"]
  },
  "concept_blocks": [
    { "concept": "regulatory_sandbox", "terms": ["regulatory sandbox", "fintech regulatory sandbox"] },
    { "concept": "innovation", "terms": ["innovation", "financial innovation", "fintech innovation"] }
  ],
  "sources": [
    "crossref", "nber", "datacite", "arxiv", "core", "openalex",
    "google-scholar", "ssrn", "ideas-repec", "econpapers",
    "cepr", "iza", "cnki", "wanfang"
  ],
  "source_policy": {
    "preferred_sources": ["crossref", "nber"],
    "allowed_sources": [
      "crossref", "nber", "datacite", "arxiv", "core", "openalex",
      "google-scholar", "ssrn", "ideas-repec", "econpapers",
      "cepr", "iza", "cnki", "wanfang"
    ],
    "excluded_sources": ["semantic-scholar"],
    "max_records_per_source": 20,
    "require_search_log": true
